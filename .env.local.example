# ── Next.js App ───────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
SESSION_SECRET=your-secret-key-min-32-characters-long

# ── AI Fix Agent (scripts/ai-fix-agent.mjs) ───────────────────────────────────
# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: OpenAI model used by the agent (default: gpt-4o)
# Examples: gpt-4o, gpt-4o-mini, o1-mini
AI_MODEL=gpt-5.4-mini

# Optional: max iterations of the verify-fix loop per failing test (default: 3)
AI_MAX_ITERATIONS=3